# Loopback only. The API refuses other bind hosts.
VERITAS_HOST=127.0.0.1
VERITAS_PORT=8000

# SQLite file created on readiness. Relative paths are resolved from the process working directory.
VERITAS_DB_PATH=data/veritas.db

# Browser origin allowed by CORS. The dashboard runs on this origin.
VERITAS_CORS_ORIGIN=http://127.0.0.1:5173

# auto uses a verified model artifact when VERITAS_MODEL_PATH is set, otherwise rules only.
# rule_only ignores a model. hybrid requires a verified artifact and falls back to rules if it is absent.
VERITAS_SCORING_MODE=auto
# VERITAS_MODEL_PATH=data/iforest-v1.joblib

# Paths only. The private key is generated under .local/keys and is gitignored.
# The trust registry beside it holds the pinned public key. Do not put key material here.
VERITAS_SIGNING_KEY_PATH=.local/keys/issuer.pem
VERITAS_SIGNING_KEY_ID=issuer-local-1

# Local Anvil only. make contract-deploy writes the address into gitignored .env.local.
# Anvil sample accounts are public insecure credentials. Do not put a private key here.
# VERITAS_CHAIN_RPC_URL=http://127.0.0.1:8545
# VERITAS_CHAIN_ID=31337
# VERITAS_CONTRACT_ADDRESS=
# VERITAS_CONTRACT_CODE_SHA256=
